# Supabase (server-side only; never expose the secret key to a browser)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Database password, used by `supabase link`
SUPABASE_PASS=

# Azure OpenAI: embeddings
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Answering model: any OpenAI-compatible endpoint (here vLLM on a GPU node)
QWEN_BASE_URL=http://<gpu-host>:8000/v1
QWEN_MODEL=Qwen/Qwen3-8B-FP8

# Owner of ingested documents and of terminal sessions (a Supabase auth user id)
RAG_OWNER_ID=
