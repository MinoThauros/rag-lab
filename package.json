{
  "name": "rag-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "clean:book": "tsx src/cleanBook.ts",
    "chunk:book": "tsx src/chunkBook.ts",
    "load:chunks": "tsx --env-file=.env src/loadChunks.ts",
    "embed:chunks": "tsx --env-file=.env src/embedChunks.ts",
    "search": "tsx --env-file=.env src/search.ts",
    "ask": "tsx --env-file=.env src/ask.ts",
    "chat": "tsx --env-file=.env src/chat.ts",
    "web:api": "tsx --env-file=.env src/web.ts",
    "web": "concurrently -k -n api,web -c blue,green \"npm:web:api\" \"npm:web:ui\"",
    "web:ui": "npm --prefix web run dev"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.52.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "js-tiktoken": "^1.0.21",
    "mdast-util-to-string": "^4.0.0",
    "openai": "^6.49.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unpdf": "^1.7.0"
  }
}
